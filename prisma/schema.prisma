generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MANAGER
  STAFF
}

enum DocStatus {
  DRAFT
  WAITING
  READY
  DONE
  CANCELED
}

enum DocType {
  RECEIPT
  DELIVERY
  TRANSFER
  ADJUSTMENT
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(STAFF)
  otpCode      String?
  otpExpiresAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  stockLedgers      StockLedger[]
  receipts          Receipt[]
  deliveryOrders    DeliveryOrder[]
  internalTransfers InternalTransfer[]
  stockAdjustments  StockAdjustment[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]
}

model Product {
  id                 String   @id @default(cuid())
  sku                String   @unique
  name               String
  description        String?
  categoryId         String
  category           Category @relation(fields: [categoryId], references: [id])
  unitOfMeasure      String   @default("Units")
  price              Decimal  @db.Decimal(12, 2)
  cost               Decimal  @default(0) @db.Decimal(12, 2)
  minStockThreshold  Decimal  @default(10) @db.Decimal(12, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  stockLedgers          StockLedger[]
  receiptItems          ReceiptItem[]
  deliveryOrderItems    DeliveryOrderItem[]
  internalTransferItems InternalTransferItem[]
  stockAdjustmentItems  StockAdjustmentItem[]

  @@index([categoryId])
}

model Warehouse {
  id        String     @id @default(cuid())
  name      String     @unique
  code      String     @unique
  address   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  locations Location[]
}

model Location {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  name        String
  code        String
  type        String    @default("STORAGE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  stockLedgers             StockLedger[]
  receiptsAsDestination    Receipt[]
  deliveryOrdersAsSource   DeliveryOrder[]
  receiptItems             ReceiptItem[]
  deliveryOrderItems       DeliveryOrderItem[]
  sourceTransfers          InternalTransfer[]    @relation("TransferSource")
  destinationTransfers     InternalTransfer[]    @relation("TransferDestination")
  stockAdjustmentItems     StockAdjustmentItem[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
}

model StockLedger {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id])
  locationId         String
  location           Location @relation(fields: [locationId], references: [id])
  quantityDelta      Decimal  @db.Decimal(12, 2)
  balanceAfter       Decimal  @db.Decimal(12, 2)
  referenceDocType   DocType
  referenceDocId     String
  referenceDocNumber String
  notes              String?
  createdById        String
  createdBy          User     @relation(fields: [createdById], references: [id])
  createdAt          DateTime @default(now())

  @@index([productId])
  @@index([locationId])
  @@index([createdAt])
  @@index([referenceDocType, referenceDocId])
}

model Receipt {
  id                    String        @id @default(cuid())
  receiptNumber         String        @unique
  supplierName          String
  supplierInvoice       String?
  status                DocStatus     @default(DRAFT)
  destinationLocationId String?
  destinationLocation   Location?     @relation(fields: [destinationLocationId], references: [id])
  notes                 String?
  createdById           String
  createdBy             User          @relation(fields: [createdById], references: [id])
  validatedAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  items ReceiptItem[]

  @@index([status])
}

model ReceiptItem {
  id               String    @id @default(cuid())
  receiptId        String
  receipt          Receipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId        String
  product          Product   @relation(fields: [productId], references: [id])
  quantityExpected Decimal   @db.Decimal(12, 2)
  quantityReceived Decimal   @default(0) @db.Decimal(12, 2)
  locationId       String?
  location         Location? @relation(fields: [locationId], references: [id])
  unitPrice        Decimal   @default(0) @db.Decimal(12, 2)

  @@index([receiptId])
  @@index([productId])
}

model DeliveryOrder {
  id               String              @id @default(cuid())
  deliveryNumber   String              @unique
  customerName     String
  customerAddress  String?
  status           DocStatus           @default(DRAFT)
  sourceLocationId String?
  sourceLocation   Location?           @relation(fields: [sourceLocationId], references: [id])
  notes            String?
  createdById      String
  createdBy        User                @relation(fields: [createdById], references: [id])
  shippedAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  items DeliveryOrderItem[]

  @@index([status])
}

model DeliveryOrderItem {
  id              String        @id @default(cuid())
  deliveryOrderId String
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantityOrdered Decimal       @db.Decimal(12, 2)
  quantityShipped Decimal       @default(0) @db.Decimal(12, 2)
  locationId      String?
  location        Location?     @relation(fields: [locationId], references: [id])
  unitPrice       Decimal       @default(0) @db.Decimal(12, 2)

  @@index([deliveryOrderId])
  @@index([productId])
}

model InternalTransfer {
  id                    String                 @id @default(cuid())
  transferNumber        String                 @unique
  status                DocStatus              @default(DRAFT)
  sourceLocationId      String
  sourceLocation        Location               @relation("TransferSource", fields: [sourceLocationId], references: [id])
  destinationLocationId String
  destinationLocation   Location               @relation("TransferDestination", fields: [destinationLocationId], references: [id])
  notes                 String?
  createdById           String
  createdBy             User                   @relation(fields: [createdById], references: [id])
  executedAt            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  items InternalTransferItem[]

  @@index([status])
}

model InternalTransferItem {
  id         String           @id @default(cuid())
  transferId String
  transfer   InternalTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String
  product    Product          @relation(fields: [productId], references: [id])
  quantity   Decimal          @db.Decimal(12, 2)

  @@index([transferId])
  @@index([productId])
}

model StockAdjustment {
  id               String                @id @default(cuid())
  adjustmentNumber String                @unique
  reason           String
  status           DocStatus             @default(DRAFT)
  createdById      String
  createdBy        User                  @relation(fields: [createdById], references: [id])
  appliedAt        DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  items StockAdjustmentItem[]

  @@index([status])
}

model StockAdjustmentItem {
  id               String          @id @default(cuid())
  adjustmentId     String
  adjustment       StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  locationId       String
  location         Location        @relation(fields: [locationId], references: [id])
  recordedQuantity Decimal         @db.Decimal(12, 2)
  countedQuantity  Decimal         @db.Decimal(12, 2)
  variance         Decimal         @db.Decimal(12, 2)

  @@index([adjustmentId])
  @@index([productId])
  @@index([locationId])
}
